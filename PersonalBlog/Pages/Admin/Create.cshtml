@page
@model PersonalBlog.Pages.Admin.CreateModel
@{
}

<div class="container my-5">
    <h1>Create New Article</h1>
    <form method="post" enctype="multipart/form-data">
        <div class="form-group mb-3">
            <label asp-for="Article.Title" class="form-label">Article Title</label>
            <input type="text" asp-for="Article.Title" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Article.Description" class="form-label">Article Description</label>
            <textarea asp-for="Article.Description" id="articleBody" class=""></textarea>
        </div>
        <div class="form-group mb-3 px-4 py-4 bg-dark-subtle rounded">
            <input type="file" asp-for="Image" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary mb-5">Save</button>
    </form>
</div>


@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script>
        new EasyMDE({ element: document.getElementById("articleBody") });
    </script>
}
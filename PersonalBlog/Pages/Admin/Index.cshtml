@page
@model PersonalBlog.Pages.Admin.IndexModel
@{
}

<section class="container mt-3">
    <h1>Admin Panel</h1>
    <p>Welcome to the admin panel!</p>
    <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h2 class="fs-2">Personal Blog</h2>
            <a class="btn btn-link" asp-page="/Admin/Create">+ New Article</a>
        </div>
        @foreach (var article in Model.Articles)
        {
            <div class="d-flex justify-content-between align-items-center border border-dark-subtle px-4 py-2 rounded mb-3">
                <h3 class="fs-3 mb-0">@article.Title</h3>
                <div class="d-flex justify-content-center align-items-center gap-3">
                    <a class="btn btn-outline-primary" asp-page="/Admin/Edit" asp-route-id="@article.Id">Edit</a>
                    <a class="btn btn-outline-danger" asp-page="/Admin/Delete" asp-route-id="@article.Id">Delete</a>
                </div>
            </div>
        }
    </div>
</section>
@page
@model IndexModel
@{
    ViewData["Title"] = "Articles";
}
@using PersonalBlog.Helpers


<div class="homepage pt-5">
    <section class="container mx-auto row row-cols-lg-3 g-3">
        @foreach (var article in Model.Articles)
        {
            <div class="col">
                <div class="bg-white card box-shadow article-card-hover">
                    <img src="@article.ImageUrl" class="card-img-top" />
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title">@article.Title</h5>
                            <p class="text-muted">@PersianDateHelper.ToPersianDate(article.CreatedAt)</p>
                        </div>
                        <p class="card-text mt-1">@article.Description</p>
                        <a class="btn btn-outline-primary" href="/Article/@article.Id">View Article</a>
                    </div>
                </div>
            </div>
        }
    </section>
</div>
